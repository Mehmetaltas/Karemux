# AI sağlayıcısı - şu an sadece "anthropic" destekleniyor, ileride değiştirilebilir
AI_PROVIDER=anthropic

# Oturum imzalama anahtarı (rastgele, uzun bir metin olsun — örn: openssl rand -hex 32)
JWT_SECRET=

# Cron görevlerini korumak için rastgele bir anahtar (openssl rand -hex 16)
CRON_SECRET=

# Resend (e-posta gönderimi - resend.com'dan ücretsiz hesap açılabilir)
RESEND_API_KEY=

# Anthropic (console.anthropic.com'dan alınır)
ANTHROPIC_API_KEY=sk-ant-...

# Neon Postgres (neon.tech panelinden "Connection string")
DATABASE_URL=postgresql://kullanici:sifre@ep-xxxx.neon.tech/karemux?sslmode=require

# iyzico (Merchant Panel > Ayarlar > API Anahtarları)
IYZICO_API_KEY=sandbox-...
IYZICO_SECRET_KEY=sandbox-...
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

# Sitenin canlı adresi (ödeme callback'i için gerekli)
NEXT_PUBLIC_SITE_URL=https://karemux.com
